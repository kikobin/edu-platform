# Пример переменных окружения
# Скопируй этот файл в .env.local и заполни значения

# ── Supabase ──────────────────────────────────────────────────────────────────
# Получи на https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...       # anon/public key
SUPABASE_SERVICE_KEY=eyJhbGc...                # service_role key (secret, server-only)

# ── Sentry (мониторинг ошибок) ────────────────────────────────────────────────
# Получи на https://sentry.io → Project → Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
SENTRY_AUTH_TOKEN=sntrys_...                   # для source maps при деплое

# ── URL приложения ────────────────────────────────────────────────────────────
# На Vercel подставляется автоматически через VERCEL_URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
